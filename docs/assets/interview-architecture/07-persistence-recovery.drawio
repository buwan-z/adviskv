<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="07｜持久化、Snapshot 与恢复" id="07-persistence-recovery"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1640" pageHeight="1350" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="07｜持久化、Snapshot 与恢复" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="Snapshot 对应明确 apply 边界；恢复先还原快照与 Raft 日志，后续已提交日志由 Applier 推进。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1560" height="30" as="geometry" /></mxCell><mxCell id="rep" value="Replica 对象" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;fillColor=#DDF1E1;swimlaneFillColor=#F2FAF4;strokeColor=#A6B0BC;fontSize=20;fontStyle=1;align=left;spacingLeft=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1110" height="1050" as="geometry" /></mxCell><mxCell id="disk" value="本副本本地磁盘" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;fillColor=#FBE6D6;swimlaneFillColor=#FEF7F1;strokeColor=#A6B0BC;fontSize=20;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="140" width="350" height="1050" as="geometry" /></mxCell><mxCell id="core" value="&lt;b&gt;RaftCore / ReplicaLoop&lt;/b&gt;&lt;br&gt;meta / WAL Effects&lt;br&gt;加载 Raft 状态与日志" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DDF1F2;strokeColor=#A6B0BC;fontColor=#1C2B3A;fontSize=17;spacing=10;" vertex="1" parent="rep"><mxGeometry x="40" y="80" width="360" height="115" as="geometry" /></mxCell><mxCell id="applier" value="&lt;b&gt;ReplicaApplier&lt;/b&gt;&lt;br&gt;extract committed → apply" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;f